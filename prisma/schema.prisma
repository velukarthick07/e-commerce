// FMCG E-commerce Admin Panel + Local Orders — data model
// Prisma 7 (`prisma-client` generator; datasource URL comes from prisma7.config.ts)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
}

enum ProductType {
  FOOD
  OIL
  PERSONAL_CARE
  HOUSEHOLD
  GROCERY
  OTHER
}

enum ExtractionMethod {
  COLD_PRESSED
  WOOD_PRESSED
  FILTERED
  REFINED
  NOT_APPLICABLE
}

enum OrderChannel {
  ONLINE
  LOCAL
}

enum OrderType {
  LOCAL_DELIVERY
  STORE_PICKUP
  WALK_IN
  PHONE_ORDER
  WHATSAPP_ORDER
  ONLINE_ORDER
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  ONLINE_PAYMENT
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum InventoryTransactionType {
  STOCK_ADDED
  STOCK_REMOVED
  ORDER_DEDUCTION
  RETURN
  MANUAL_ADJUSTMENT
  EXPIRED_STOCK
}

// ---------------------------------------------------------------------------
// Auth / RBAC
// ---------------------------------------------------------------------------

model Role {
  id          Int              @id @default(autoincrement())
  name        RoleName         @unique
  label       String
  description String?
  isSystem    Boolean          @default(true)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  resource    String
  action      String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id                   Int       @id @default(autoincrement())
  name                 String
  email                String    @unique
  phone                String?
  passwordHash         String
  avatarUrl            String?
  isActive             Boolean   @default(true)
  lastLoginAt          DateTime?
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  roleId               Int
  role                 Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdOrders         Order[]                @relation("OrderCreatedBy")
  inventoryTransactions InventoryTransaction[]
  recordedPayments      Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  parentId    Int?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")

  products      Product[] @relation("ProductCategory")
  subProducts   Product[] @relation("ProductSubcategory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([name])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  sku              String   @unique
  barcode          String?  @unique
  brand            String?
  description      String?
  shortDescription String?
  images           String[] @default([])

  categoryId    Int
  category      Category @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId Int?
  subcategory   Category? @relation("ProductSubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)

  // Pricing defaults (authoritative price lives on the variant)
  mrp           Decimal  @db.Decimal(12, 2)
  sellingPrice  Decimal  @db.Decimal(12, 2)
  discountPrice Decimal? @db.Decimal(12, 2)
  taxRate       Decimal  @default(0) @db.Decimal(5, 2)
  hsnCode       String?

  // Stock defaults applied to new variants
  minStock Int     @default(10)
  maxStock Int     @default(1000)
  unit     String  @default("piece")

  netQuantity String?
  weight      Decimal? @db.Decimal(10, 3)
  lengthCm    Decimal? @db.Decimal(10, 2)
  widthCm     Decimal? @db.Decimal(10, 2)
  heightCm    Decimal? @db.Decimal(10, 2)

  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)

  // --- FMCG attributes ---
  productType             ProductType       @default(OTHER)
  ingredients             String?
  nutritionalInfo         Json?
  allergens               String?
  dietaryInfo             String?
  storageInstructions     String?
  preparationInstructions String?
  shelfLifeDays           Int?
  countryOfOrigin         String?           @default("India")
  manufacturer            String?
  packer                  String?
  fssaiLicense            String?
  // Oil-specific
  oilType                 String?
  extractionMethod        ExtractionMethod? @default(NOT_APPLICABLE)
  packagingType           String?
  // Personal care specific
  fragrance               String?

  variants     ProductVariant[]
  inventory    Inventory[]
  batches      InventoryBatch[]
  transactions InventoryTransaction[]
  orderItems   OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([brand])
  @@map("products")
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  sku           String   @unique
  barcode       String?  @unique
  mrp           Decimal  @db.Decimal(12, 2)
  sellingPrice  Decimal  @db.Decimal(12, 2)
  discountPrice Decimal? @db.Decimal(12, 2)
  weightGrams   Decimal? @db.Decimal(10, 3)
  volumeMl      Decimal? @db.Decimal(10, 2)
  imageUrl      String?
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)

  inventory    Inventory?
  batches      InventoryBatch[]
  transactions InventoryTransaction[]
  orderItems   OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([isActive])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Inventory {
  id              Int            @id @default(autoincrement())
  productId       String
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String         @unique
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  currentStock    Int            @default(0)
  reservedStock   Int            @default(0)
  minStock        Int            @default(10)
  maxStock        Int            @default(1000)
  lastRestockedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([currentStock])
  @@map("inventory")
}

model InventoryBatch {
  id                String         @id @default(cuid())
  batchNumber       String
  productId         String
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  manufacturingDate DateTime?
  expiryDate        DateTime?
  bestBeforeDate    DateTime?
  quantity          Int
  remainingQuantity Int
  purchasePrice     Decimal?       @db.Decimal(12, 2)
  mrp               Decimal?       @db.Decimal(12, 2)
  sellingPrice      Decimal?       @db.Decimal(12, 2)
  receivedDate      DateTime       @default(now())
  isActive          Boolean        @default(true)

  transactions InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variantId, batchNumber])
  @@index([batchNumber])
  @@index([expiryDate])
  @@index([productId])
  @@map("inventory_batches")
}

model InventoryTransaction {
  id            String                   @id @default(cuid())
  type          InventoryTransactionType
  productId     String
  product       Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  batchId       String?
  batch         InventoryBatch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)
  quantity      Int
  previousStock Int
  newStock      Int
  referenceType String?
  referenceId   String?
  orderId       String?
  order         Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId        Int?
  user          User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  note          String?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_transactions")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id       String  @id @default(cuid())
  name     String
  phone    String  @unique
  email    String?
  isActive Boolean @default(true)
  notes    String?

  /// Set when the customer signs in to the storefront with an OTP.
  lastLoginAt DateTime?

  addresses CustomerAddress[]
  orders    Order[]
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([email])
  @@index([isActive])
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   @default("Home")
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  landmark   String?
  isDefault  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("customer_addresses")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id          String       @id @default(cuid())
  orderNumber String       @unique
  channel     OrderChannel
  orderType   OrderType
  status      OrderStatus  @default(PENDING)

  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName  String
  customerPhone String
  customerEmail String?

  deliveryType    DeliveryType @default(DELIVERY)
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  postalCode      String?
  deliveryNotes   String?

  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  itemDiscount   Decimal @default(0) @db.Decimal(12, 2)
  couponDiscount Decimal @default(0) @db.Decimal(12, 2)
  manualDiscount Decimal @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  deliveryCharge Decimal @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal @default(0) @db.Decimal(12, 2)

  couponId   String?
  coupon     Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode String?

  paymentStatus PaymentStatus @default(PENDING)
  notes         String?

  createdByUserId Int?
  createdBy       User? @relation("OrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  items         OrderItem[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]
  transactions  InventoryTransaction[]

  placedAt    DateTime  @default(now())
  deliveredAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([channel])
  @@index([orderType])
  @@index([paymentStatus])
  @@index([placedAt])
  @@index([createdByUserId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  // Snapshots — the catalogue can change after the order is placed
  productName String
  variantName String
  sku         String
  imageUrl    String?

  mrp            Decimal @db.Decimal(12, 2)
  unitPrice      Decimal @db.Decimal(12, 2)
  quantity       Int
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxRate        Decimal @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  userId    Int?
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

model Payment {
  id            String        @id @default(cuid())
  paymentNumber String        @unique
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?
  paidAt        DateTime?
  notes         String?

  recordedByUserId Int?
  recordedBy       User? @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([method])
  @@index([createdAt])
  @@map("payments")
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  description    String?
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(12, 2)
  minOrderValue  Decimal      @default(0) @db.Decimal(12, 2)
  maxDiscount    Decimal?     @db.Decimal(12, 2)
  usageLimit     Int?
  usedCount      Int          @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean      @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([expiresAt])
  @@map("coupons")
}

// ---------------------------------------------------------------------------
// Settings & sequences
// ---------------------------------------------------------------------------

model StoreSettings {
  id            Int     @id @default(1)
  storeName     String  @default("My FMCG Store")
  legalName     String?
  email         String?
  phone         String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  country       String  @default("India")
  gstNumber     String?
  fssaiLicense  String?
  logoUrl       String?
  currency      String  @default("INR")
  currencySymbol String @default("₹")
  timezone      String  @default("Asia/Kolkata")

  deliverySettings     Json @default("{}")
  paymentSettings      Json @default("{}")
  taxSettings          Json @default("{}")
  orderSettings        Json @default("{}")
  notificationSettings Json @default("{}")
  securitySettings     Json @default("{}")
  preferences          Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("store_settings")
}

/// Atomic per-day counter backing human-readable order numbers (ORD-/LOC-)
model OrderSequence {
  id         Int    @id @default(autoincrement())
  prefix     String
  dateKey    String
  lastNumber Int    @default(0)

  @@unique([prefix, dateKey])
  @@map("order_sequences")
}

/// One-time passcodes backing storefront sign-in and order tracking.
/// Only the hash is stored, so a database leak cannot be replayed as a login.
model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  purpose    String    @default("LOGIN")
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}
