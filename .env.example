# ---- Database ----
# Password characters :, # are percent-encoded (%3A, %23) for URL safety
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fmcg_admin?schema=public&connection_limit=10&pool_timeout=20"

# ---- Setup wizard ----
# Until setup has run, /setup asks for a one-time key printed in the server
# console (and saved to .setup-key) before it will touch the database. Without
# it, anyone who can reach the port during installation could create the first
# administrator. Set to false only on a machine nobody else can reach.
SETUP_REQUIRE_KEY="true"

# ---- Auth ----
JWT_SECRET="generate-with-openssl-rand-hex-32"
JWT_EXPIRES_IN="7d"

# ---- App ----
APP_URL="http://localhost:3000"
CLIENT_URL="http://localhost:3000"
# Uploaded images live here, outside public/ — Next only indexes public/
# at boot, so files added later would not be served until a restart.
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB="5"
# Uploaded images are re-encoded to WebP and scaled to fit this many pixels on
# the longest side. 82 is visually lossless for photographs; raise it for
# finer detail at the cost of file size.
IMAGE_MAX_DIMENSION="1600"
IMAGE_QUALITY="82"

# ---- Seed demo credentials ----
SEED_SUPER_ADMIN_EMAIL="superadmin@fmcg.local"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe@123"
SEED_ADMIN_EMAIL="admin@fmcg.local"
SEED_ADMIN_PASSWORD="ChangeMe@123"
SEED_MANAGER_EMAIL="manager@fmcg.local"
SEED_MANAGER_PASSWORD="ChangeMe@123"
SEED_STAFF_EMAIL="staff@fmcg.local"
SEED_STAFF_PASSWORD="ChangeMe@123"

# ---- Storefront (customer site) ----
# Sign-in codes are returned in the API response as well as logged to the
# server console while no SMS provider is configured. Set to false (and
# implement deliverOtp in src/lib/otp.ts) before going live.
OTP_ECHO=true
CUSTOMER_JWT_EXPIRES_IN=30d
# Fill a returning shopper's saved name and address from their mobile number
# alone, skipping OTP. Off by default: it would let anyone read a customer's
# details by guessing a phone number.
STOREFRONT_OPEN_AUTOFILL=false
